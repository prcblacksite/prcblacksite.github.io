{
  "name": "prcblacksite",
  "type": "module",
  "private": true,
  "description": "prcblacksite.github.io: PRC's website, built with Astro from Markdown and prc.yaml.",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/og.mjs && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check:site": "node scripts/check-site.mjs && python3 scripts/check_roadmap.py && playwright test"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.3.3",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/ibm-plex-sans": "5.3.0",
    "astro": "7.3.8",
    "hast-util-to-html": "9.0.5",
    "markdown-it": "14.1.0",
    "mdast-util-to-hast": "13.2.1",
    "remark-heading-id": "1.0.1",
    "unist-util-visit": "5.1.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@resvg/resvg-js": "2.6.2",
    "@types/markdown-it": "14.2.0",
    "pagefind": "1.5.2",
    "typescript": "7.0.2"
  }
}
